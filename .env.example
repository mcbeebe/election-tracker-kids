# Copy to .env.local — never commit real values.

# civicAPI (no key needed)
CIVICAPI_BASE=https://civicapi.org/api/v2
CIVICAPI_MIN_INTERVAL_MS=1000
# Per-request timeout (ms). Under election-night load civicAPI answered after ~49 s.
CIVICAPI_TIMEOUT_MS=60000

# Supabase (server-side only; do NOT expose the service role key to the browser)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Phase 1 — AI summaries (Claude Haiku). Leave empty to disable the feature.
ANTHROPIC_API_KEY=
AI_SUMMARY_INTERVAL_MIN=10

# Refresh cadence
RESULTS_TTL_SECONDS=45

# Dev only: replay recorded fixtures instead of calling civicAPI (refused in production)
RESULTS_PROVIDER=civicapi
